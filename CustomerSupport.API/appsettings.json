{
  "ConnectionStrings": {
    "CustomerSupportDatabase": "Server=localhost;Database=CustomerSupportDatabase;Integrated Security=True;TrustServerCertificate=True;Trusted_Connection=True;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Properties": {
      "Application": "CustomerSupport.Api"
    }
  },
  "AllowedHosts": "*"
}
